// A tall torch's flame, its head to the right. Written for this project; the textures are read from
// the user's own install at run time.
particlesystem "OurTorchTall" 1
{
    MinEmitTime = 2

    // The body: short broad tongues that leap up from the torch head and die.
    eventsequence "tongues"
    {
        type = Axial
        texture = "03003019_torch.tga"
        destBlendMode = ALPHA_ONE
        numparticles = 7
        emitrate = 12
        lifetime = random(0.32,0.5)
        chaoslocation = XYZ(random(0.19,0.31),0,random(2.92,3.06))
        initial velocity = XYZ(random(-0.08,0.08),0,random(0.1,0.3))
        initial length = 0.45
        fade so at 0.1 length = random(1.0,1.45)
        fade so final length = 0.55
        initial scale = 0.62
        fade so final scale = 0.28
        initial color = RGBA(0.1,0.05,0.01,1)
        fade so at 0.09 color = RGBA(0.52,0.3,0.1,1)
        fade so final color = RGBA(0,0,0,1)
    }

    // Thin licks that reach past the body and make the tip restless.
    eventsequence "licks"
    {
        type = Axial
        texture = "03003020_torch.tga"
        destBlendMode = ALPHA_ONE
        numparticles = 4
        emitrate = 6
        lifetime = random(0.4,0.65)
        chaoslocation = XYZ(random(0.15,0.35),0,random(3.05,3.25))
        initial velocity = XYZ(random(-0.15,0.15),0,random(0.2,0.5))
        initial length = 0.7
        fade so final length = random(1.3,1.9)
        initial scale = 0.36
        fade so final scale = 0.16
        initial color = RGBA(0.4,0.18,0.04,1)
        fade so final color = RGBA(0,0,0,1)
    }

    // A soft warm bloom behind the fire.
    eventsequence "bloom"
    {
        texture = "03002014_flare.tga"
        destBlendMode = ALPHA_ONE
        numparticles = 3
        emitrate = 4
        lifetime = 0.7
        chaoslocation = XYZ(0.25,0,random(3.25,3.35))
        initial scale = random(2.4,2.9)
        initial color = RGBA(0,0,0,1)
        fade so at 0.3 color = RGBA(0.2,0.11,0.04,1)
        fade so final color = RGBA(0,0,0,1)
    }

    // An occasional spark drifting up.
    eventsequence "sparks"
    {
        texture = "03002014_flare.tga"
        destBlendMode = ALPHA_ONE
        numparticles = 3
        emitrate = 1.4
        lifetime = random(0.7,1.2)
        chaoslocation = XYZ(random(0.15,0.35),0,random(3.4,3.6))
        initial velocity = XYZ(random(-0.3,0.3),0,random(0.5,1))
        initial scale = 0.42
        fade so final scale = 0.12
        initial color = RGBA(1,0.55,0.15,1)
        fade so final color = RGBA(0,0,0,1)
    }
}
